@@ -0,0 +1,30 @@
+//! Build-time VM dispatch selection; state remains the default.
+
+pub(super) fn flags(mode: Option<&str>) -> Result<Vec<String>,String> {
+    match mode {
+        None | Some("") | Some("state") => Ok(Vec::new()),
+        Some("direct") => Ok(vec!["--cfg".into(),"feature=\"vm_direct_dispatch\"".into()]),
+        Some(_) => Err("FEMACS_VM_DISPATCH must be state or direct".into()),
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    fn timed(name: &str, run: impl FnOnce()) {
+        let start=std::time::Instant::now(); run();
+        println!("CASE {name} seconds={:.6}",start.elapsed().as_secs_f64());
+    }
+    #[test]
+    fn default_and_state_add_no_experimental_cfg() {timed("vm_default",||{
+        for value in [None,Some(""),Some("state")] {assert!(flags(value).unwrap().is_empty());}
+    });}
+    #[test]
+    fn direct_has_exactly_the_registered_feature() {timed("vm_direct",||{
+        assert_eq!(flags(Some("direct")).unwrap(),vec!["--cfg","feature=\"vm_direct_dispatch\""]);
+    });}
+    #[test]
+    fn unknown_mode_fails_instead_of_falling_back() {timed("vm_unknown",||{
+        for value in ["DIRECT","auto","threaded","state extra"] {assert!(flags(Some(value)).is_err());}
+    });}
+}
