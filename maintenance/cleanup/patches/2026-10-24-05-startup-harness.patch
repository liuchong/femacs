+def run_pty_user_init_check(binary: Path, out_dir: Path, timeout: int) -> dict:
+    """Verify real interactive TTY default startup (no -Q, no -q, no --batch, no -l) loads ~/.emacs.d/{early-init,init}.el."""
+    pty_home = out_dir / "pty-init-home"
+    dot_emacs = pty_home / ".emacs.d"
+    dot_emacs.mkdir(parents=True, exist_ok=False)
+    report_file = pty_home / "pty-startup-report.json"
+    early_init = dot_emacs / "early-init.el"
+    user_init = dot_emacs / "init.el"
+    early_init.write_text(
+        ";; -*- lexical-binding: t; -*-\n"
+        "(defvar femacs-pty-boot-trace nil)\n"
+        "(push 'early-init femacs-pty-boot-trace)\n"
+        "(setq package-enable-at-startup nil inhibit-startup-screen t)\n",
+        encoding="utf-8",
+    )
+    user_init.write_text(
+        ";; -*- lexical-binding: t; -*-\n"
+        "(require 'json)\n"
+        "(push 'user-init femacs-pty-boot-trace)\n"
+        "(add-hook 'emacs-startup-hook\n"
+        "  (lambda ()\n"
+        "    (push 'emacs-startup femacs-pty-boot-trace)\n"
+        f"    (let ((coding-system-for-write 'utf-8-unix))\n"
+        f"      (with-temp-file {elisp_quote_string(str(report_file.resolve()))}\n"
+        "        (insert (json-encode\n"
+        "                 `((noninteractive . ,(if noninteractive t :json-false))\n"
+        "                   (trace . ,(vconcat (mapcar #'symbol-name (reverse femacs-pty-boot-trace))))\n"
+        "                   (early_init_ok . ,(if (and early-init-file (string-suffix-p \"early-init.el\" early-init-file)) t :json-false))\n"
+        "                   (user_init_ok . ,(if (and user-init-file (string-suffix-p \"init.el\" user-init-file)) t :json-false)))))))\n"
+        "    (kill-emacs 0)))\n",
+        encoding="utf-8",
+    )
+    master_fd, slave_fd = pty.openpty()
+    env = {
+        "HOME": str(pty_home.resolve()),
+        "TMPDIR": str(pty_home.resolve()),
+        "PATH": os.defpath,
+        "TERM": "xterm-256color",
+        "LC_ALL": "en_US.UTF-8",
+    }
+    started = time.monotonic()
+    proc = None
+    errors: list[str] = []
+    try:
+        proc = subprocess.Popen(
+            [
+                str(binary.resolve()),
+                "--no-site-file",
+                "--no-site-lisp",
+                "--init-directory",
+                str(dot_emacs.resolve()),
+                "-nw",
+            ],
+            stdin=slave_fd,
+            stdout=slave_fd,
+            stderr=slave_fd,
+            cwd=str(pty_home.resolve()),
+            env=env,
+            close_fds=True,
+        )
+        os.close(slave_fd)
+        slave_fd = -1
+        while proc.poll() is None:
+            if time.monotonic() - started > min(timeout, 60):
+                proc.kill()
+                proc.wait(timeout=5)
+                errors.append("PTY non-Q user-init startup timed out")
+                break
+            rlist, _, _ = select.select([master_fd], [], [], 0.05)
+            if rlist:
+                try:
+                    os.read(master_fd, 4096)
+                except OSError:
+                    break
+        if proc.returncode != 0:
+            errors.append(f"PTY non-Q user-init process exited with {proc.returncode}")
+    finally:
+        if slave_fd >= 0:
+            try:
+                os.close(slave_fd)
+            except OSError:
+                pass
+        try:
+            os.close(master_fd)
+        except OSError:
+            pass
+        if proc is not None and proc.poll() is None:
+            proc.kill()
+            proc.wait(timeout=5)
