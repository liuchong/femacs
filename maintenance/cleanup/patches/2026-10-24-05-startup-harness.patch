+unsafe fn focus_window(pid:i32, title:&str)->Result<(),String> {
+    if pid<=0 {return Err("invalid PID".into())}
+    unsafe {
+        let app=AXUIElementCreateApplication(pid);
+        let key=|value:&str|->Result<*const c_void,String>{
+            let s=CString::new(value).map_err(|_|"invalid AX string")?;
+            Ok(CFStringCreateWithCString(ptr::null(),s.as_ptr(),0x08000100))
+        };
+        let windows_key=key("AXWindows")?; let mut windows=ptr::null();
+        let code=AXUIElementCopyAttributeValue(app,windows_key,&mut windows);CFRelease(windows_key);
+        if code!=0 || windows.is_null(){CFRelease(app);return Err("cannot read owned app windows".into())}
+        let title_key=key("AXTitle")?;let raise=key("AXRaise")?;let main=key("AXMain")?;
+        let front=key("AXFrontmost")?;let mut found=0;
+        for i in 0..CFArrayGetCount(windows) {
+            let window=CFArrayGetValueAtIndex(windows,i);let mut value=ptr::null();
+            if AXUIElementCopyAttributeValue(window,title_key,&mut value)!=0 || value.is_null(){continue}
+            let mut buffer=vec![0 as c_char;4096];
+            let matches=CFStringGetCString(value,buffer.as_mut_ptr(),4096,0x08000100)
+                && CStr::from_ptr(buffer.as_ptr()).to_string_lossy()==title;
+            CFRelease(value);
+            if matches {
+                found+=1;
+                if AXUIElementSetAttributeValue(app,front,kCFBooleanTrue)!=0
+                    || AXUIElementSetAttributeValue(window,main,kCFBooleanTrue)!=0
+                    || AXUIElementPerformAction(window,raise)!=0 {found=-100;break}
+            }
+        }
+        for value in [front,main,raise,title_key,windows,app]{CFRelease(value)}
+        if found!=1 {return Err(format!("owned window focus needs exactly one title match, got {found}"))}
+        thread::sleep(Duration::from_millis(150));Ok(())
+    }
