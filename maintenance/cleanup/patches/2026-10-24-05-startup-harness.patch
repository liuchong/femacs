+    if not report_file.is_file():
+        errors.append(f"missing PTY startup report: {report_file}")
+    else:
+        try:
+            data = json.loads(report_file.read_text(encoding="utf-8"))
+        except (OSError, json.JSONDecodeError) as exc:
+            errors.append(f"invalid PTY startup report JSON: {exc}")
+        else:
+            if data.get("noninteractive") is not False:
+                errors.append(f"expected interactive PTY session, got noninteractive={data.get('noninteractive')!r}")
+            if data.get("trace") != ["early-init", "user-init", "emacs-startup"]:
