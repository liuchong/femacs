;;; gc-root-phases-contract.el --- Actual phase 22/23/24 observations -*- lexical-binding: t; -*-
;; Cache-only contract. It does not replace runtime-observer.el or runtime-gc.el.
;; Intervals are inclusive wall time, including recursive marking and the
;; observer calls. They are not exclusive CPU, a speedup, or the historical
;; classification-to-static-root split. Phase 24 covers one dirty/raw-tainted
;; loop. Phase 22 brackets prepare_cycle, including a major-mode return that
;; happens before the cons-block bitmap walk.

(require 'ert)
(require 'cl-lib)

(defconst rpc--complete 1)
(defconst rpc--clock 2)
(defconst rpc--incomplete 4)
(defconst rpc--export 8)
(defconst rpc--depth 16)
(defconst rpc--counter 64)
(defconst rpc--dropped-flag 128)
(defconst rpc--young 256)
(defconst rpc--full 512)
(defconst rpc--forbidden (logior rpc--clock rpc--incomplete rpc--export
                                 rpc--depth rpc--counter rpc--dropped-flag))

(defun rpc--mode ()
  (or (getenv "FEMACS_GC_OBSERVATION") "off"))

(defun rpc--recording-p ()
  (member (rpc--mode) '("phases" "all")))

(defun rpc--fail (message)
  (ert-fail message))

(defun rpc--snapshot ()
  (unless (fboundp 'femacs--gc-snapshot)
    (rpc--fail "femacs--gc-snapshot is unavailable"))
  (let ((snapshot (femacs--gc-snapshot)))
    (unless (and (vectorp snapshot) (= (length snapshot) 4) (= (aref snapshot 0) 1))
      (rpc--fail "observer snapshot wire is not [1 totals records ages]"))
    (let ((totals (aref snapshot 1))
          (records (aref snapshot 2)))
      (unless (and (vectorp totals) (= (length totals) 21)
                   (vectorp records))
        (rpc--fail "observer totals/records have the wrong shape"))
      (unless (= (aref totals 1) 4096)
        (rpc--fail "observer capacity is not the fixed 4096"))
      (unless (= (aref totals 2) (length records))
        (rpc--fail "copied record count disagrees with the record vector"))
      (unless (<= (length records) 4096)
        (rpc--fail "record vector exceeds 4096")))
    snapshot))

(defun rpc--counters-clear (snapshot)
  (let ((totals (aref snapshot 1)))
    (dolist (index '(3 4 5 6 7))
      (unless (= (aref totals index) 0)
        (rpc--fail (format "observer counter %d is nonzero: %s"
                           index (aref totals index)))))))

(defun rpc--status ()
  (unless (fboundp 'femacs--gc-collector-status)
    (rpc--fail "femacs--gc-collector-status is unavailable"))
  (let ((gc-cons-threshold most-positive-fixnum))
    (let ((status (femacs--gc-collector-status)))
      (unless (and (vectorp status) (= (length status) 3) (= (aref status 0) 1)
                   (vectorp (aref status 1)) (= (length (aref status 1)) 24))
        (rpc--fail "collector status wire is not [1 totals[24] reasons]"))
      status)))

(defun rpc--record (row)
  (unless (and (vectorp row) (= (length row) 6))
    (rpc--fail "phase record is not a six-field vector"))
  (dotimes (i 6)
    (unless (and (integerp (aref row i)) (>= (aref row i) 0))
      (rpc--fail "phase record field is not a nonnegative integer")))
  row)

(defun rpc--closed-p (row)
  (let ((flags (aref row 3)))
    (and (/= (logand flags rpc--complete) 0)
         (= (logand flags rpc--forbidden) 0)
         (>= (aref row 5) (aref row 4)))))

(defun rpc--exact-complete-p (row)
  (and (rpc--closed-p row) (= (aref row 3) rpc--complete)))

(defun rpc--classification (row)
  "Accept exactly one Young/Full bit. Full must not be rejected as non-Young."
  (let* ((flags (aref row 3))
         (reason (logand (ash flags -16) 255))
         (kind-bits (logand flags (logior rpc--young rpc--full)))
         (expected (logior rpc--complete kind-bits (ash reason 16))))
    (and (= (aref row 2) 21)
         (or (= kind-bits rpc--young) (= kind-bits rpc--full))
         (rpc--closed-p row)
         (= flags expected)
         (= (aref row 4) (aref row 5)))))

(defun rpc--by-cycle (records)
  (let ((groups nil))
    (dotimes (index (length records))
      (let* ((row (rpc--record (aref records index)))
             (cycle (aref row 0))
             (found (assoc cycle groups)))
        (unless (> cycle 0)
          (rpc--fail "phase cycle id is not positive"))
        (unless (= (aref row 1) 0)
          (rpc--fail "nested observation parent is not part of this contract"))
        (if found
            (setcdr found (cons (cons index row) (cdr found)))
          (push (cons cycle (list (cons index row))) groups))))
    groups))

(defun rpc--phase (entries phase)
  (let ((found (cl-remove-if-not (lambda (item) (= (aref (cdr item) 2) phase))
                                 entries)))
    (unless (= (length found) 1)
      (rpc--fail (format "cycle does not have exactly one phase %d" phase)))
    (car found)))

(defun rpc--check-cycle (cycle entries)
  (let* ((phase3 (rpc--phase entries 3))
         (phase22 (rpc--phase entries 22))
         (class (rpc--phase entries 21))
         (phase4 (rpc--phase entries 4))
         (row3 (cdr phase3))
         (row22 (cdr phase22))
         (row21 (cdr class))
         (row4 (cdr phase4))
         (young (/= (logand (aref row21 3) rpc--young) 0))
         (phase23 (cl-remove-if-not (lambda (item) (= (aref (cdr item) 2) 23)) entries))
         (phase24 (cl-remove-if-not (lambda (item) (= (aref (cdr item) 2) 24)) entries)))
    (unless (and (rpc--exact-complete-p row3)
                 (rpc--exact-complete-p row22)
                 (rpc--exact-complete-p row4)
                 (rpc--classification row21))
      (rpc--fail (format "cycle %d has an open, invalid, or misclassified interval" cycle)))
    (unless (and (< (car phase3) (car phase22))
                 (< (car phase22) (car class))
                 (< (car class) (car phase4)))
      (rpc--fail (format "cycle %d record order is not 3, 22, 21, 4" cycle)))
    (unless (and (<= (aref row3 4) (aref row22 4))
                 (<= (aref row22 4) (aref row22 5))
                 (<= (aref row22 5) (aref row21 4))
                 (= (aref row21 4) (aref row21 5))
                 (<= (aref row21 5) (aref row4 4))
                 (<= (aref row4 5) (aref row3 5)))
      (rpc--fail (format "cycle %d does not nest phase 22 before classification inside phase 3" cycle)))
    ;; `young` is the Young bit. Classification already required the other
    ;; possibility to be the Full bit alone, so this branch is the distinguisher.
    (if young
        (progn
          (unless (and (= (length phase23) 1) (= (length phase24) 1))
            (rpc--fail (format "young cycle %d does not have sibling phases 23 and 24" cycle)))
          (let* ((one23 (car phase23))
                 (one24 (car phase24))
                 (row23 (cdr one23))
                 (row24 (cdr one24)))
            (unless (and (rpc--exact-complete-p row23) (rpc--exact-complete-p row24))
              (rpc--fail (format "young cycle %d has an invalid 23/24 interval" cycle)))
            (unless (and (< (car class) (car one23))
                         (< (car one23) (car one24))
                         (< (car one24) (car phase4)))
              (rpc--fail (format "young cycle %d record order is not 21, 23, 24, 4" cycle)))
            (unless (and (<= (aref row21 5) (aref row23 4))
                         (<= (aref row23 4) (aref row23 5))
                         (<= (aref row23 5) (aref row24 4))
                         (<= (aref row24 4) (aref row24 5))
                         (<= (aref row24 5) (aref row4 4)))
              (rpc--fail (format "young cycle %d does not keep 23 before 24 and before phase 4" cycle)))))
      (unless (/= (logand (aref row21 3) rpc--full) 0)
        (rpc--fail (format "cycle %d classification is neither Young nor Full" cycle)))
      (unless (and (null phase23) (null phase24))
        (rpc--fail (format "Full cycle %d recorded phase 23 or 24" cycle))))
    young))

(defun rpc--check-window (snapshot young-product)
  (rpc--counters-clear snapshot)
  (let ((groups (rpc--by-cycle (aref snapshot 2)))
        (young 0)
        (full 0))
    (unless groups
      (rpc--fail "recording window has no cycles"))
    (dolist (group groups)
      (if (rpc--check-cycle (car group) (cdr group))
          (setq young (1+ young))
        (setq full (1+ full))))
    (unless (> full 0)
      (rpc--fail "window has no non-young cycle"))
    (if young-product
        (unless (> young 0)
          (rpc--fail "young collector produced no actual Young cycle"))
      (unless (= young 0)
        (rpc--fail "major collector recorded a Young classification")))))

(defun rpc--churn (count)
  (let ((gc-cons-threshold 30000)
        (gc-cons-percentage 0.0)
        (junk nil))
    (dotimes (i count)
      (setq junk (cons i junk)))
    nil))

(defun rpc--until-young (before-minors)
  (let ((remaining 32000)
        (found nil)
        (status nil))
    (while (and (> remaining 0) (not found))
      (let ((chunk (min remaining 128)))
        (rpc--churn chunk)
        (setq remaining (- remaining chunk))
        (let ((gc-cons-threshold most-positive-fixnum))
          (setq status (rpc--status)))
        (when (and (> (aref (aref status 1) 4) before-minors)
                   (= (aref (aref status 1) 2) 1))
          (setq found t))))
    (unless found
      (rpc--fail "no completed Young collector snapshot within 32000 conses"))
    status))

(defun rpc--absence ()
  (unless (fboundp 'femacs--gc-observer-control)
    (rpc--fail "phase control is unavailable in an observer product"))
  (should-error (femacs--gc-observer-control t))
  (let ((before gcs-done))
    (garbage-collect)
    (unless (> gcs-done before)
      (rpc--fail "off/survival process did not actually collect"))
    (let ((snapshot (rpc--snapshot)))
      (rpc--counters-clear snapshot)
      (unless (= (length (aref snapshot 2)) 0)
        (rpc--fail "off/survival mode recorded phase rows")))))

(defun rpc--recorded ()
  (unless (and (fboundp 'femacs--gc-observer-control)
               (fboundp 'femacs--gc-reset))
    (rpc--fail "phase window controls are unavailable"))
  (femacs--gc-observer-control nil)
  (unless (eq t (femacs--gc-reset))
    (rpc--fail "observer window reset failed"))
  (should-not (femacs--gc-observer-control t))
  (let ((gc-cons-threshold most-positive-fixnum)
        (gc-cons-percentage 0.1))
    (garbage-collect))
  (let ((young-product (= (aref (aref (rpc--status) 1) 0) 1)))
    (if young-product
        (rpc--until-young (aref (aref (rpc--status) 1) 4))
      (rpc--churn 2000))
    (femacs--gc-observer-control nil)
    (let ((gc-cons-threshold most-positive-fixnum))
      (rpc--check-window (rpc--snapshot) young-product))))

(ert-deftest rpc01-phase22-before-21-and-23-24-only-on-young ()
  "Observe phase 22 before classification, and phases 23/24 only on Young."
  (if (rpc--recording-p)
      (rpc--recorded)
    (rpc--absence)))

(provide 'gc-root-phases-contract)
;;; gc-root-phases-contract.el ends here
