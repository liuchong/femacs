;;; macos-keys.el --- Isolated native-input acceptance fixture -*- lexical-binding: t; -*-
;; New fixture, separate from the verbatim test tree.  No production key rebinding.
(setq inhibit-startup-screen t initial-scratch-message nil)
(defvar femacs-key-file (getenv "FEMACS_KEY_REPORT"))
(defvar femacs-key-buffer "*femacs-key-acceptance*")
(defun femacs-key-snapshot ()
  (when (and femacs-key-file (or (getenv "FEMACS_KEY_ALL_BUFFERS")
                               (equal (buffer-name) femacs-key-buffer)))
    (let* ((print-escape-newlines t)
           (print-escape-control-characters t)
           (record (format "%S\t%d\t%S\t%S\n" this-command (point)
                          (buffer-substring-no-properties (point-min) (point-max)) (key-description (this-command-keys-vector)))))
      (with-temp-buffer
        (insert record)
        (write-region (point-min) (point-max) femacs-key-file nil 'silent))
      (when-let* ((diagnostic (getenv "FEMACS_KEY_DIAGNOSTIC")))
        (let ((record (list :point (point) :message (current-message)
                            :font (frame-parameter nil 'font) :font-info (ignore-errors (font-info (frame-parameter nil 'font))) :frame (frame-pixel-width) :height (frame-pixel-height)
                            :char-width (frame-char-width) :char-height (frame-char-height)
                            :window-width (window-body-width) :window-height (window-body-height)
                            :messages (when (get-buffer "*Messages*")
                                        (with-current-buffer "*Messages*" (buffer-string))))))
          (with-temp-file diagnostic (prin1 record (current-buffer))))))))
(switch-to-buffer (get-buffer-create femacs-key-buffer))
(erase-buffer)
(insert "alpha beta\ngamma delta\n")
(goto-char (string-to-number (or (getenv "FEMACS_KEY_POINT") "7")))
(set-buffer-modified-p nil)
(add-hook 'post-command-hook #'femacs-key-snapshot)
(femacs-key-snapshot)
(when-let* ((path (getenv "FEMACS_KEY_GUI")))
  (with-temp-file path (insert (format "%s" (window-system)))))
