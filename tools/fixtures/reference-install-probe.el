;;; reference-install-probe.el --- Read-only installed reference facts -*- lexical-binding: t; -*-
(progn
(require 'json)
(let ((b (lambda (x) (if x t :json-false))))
(princ "FEMACS-REFERENCE-INSTALL ")
(princ (json-encode
 `((emacs_version . ,emacs-version)
   (emacs_repository_version . ,emacs-repository-version)
   (emacs_repository_branch . ,emacs-repository-branch)
   (system_configuration . ,system-configuration)
   (system_configuration_features . ,system-configuration-features)
   (lisp_directory . ,(file-truename (file-name-directory (locate-library "subr"))))
   (data_directory . ,(file-truename data-directory))
   (image_types . ,(if (boundp 'image-types) (vconcat image-types) []))
   (arithmetic . ,(+ 20 22))
   (native_comp_eln_load_path . ,(vconcat (and (boundp 'native-comp-eln-load-path) native-comp-eln-load-path)))
   (native_comp_jit . ,(if (bound-and-true-p native-comp-jit-compilation) t :json-false))
   (capabilities . ((native . ,(funcall b (and (fboundp 'native-comp-available-p) (native-comp-available-p))))
      (treesit . ,(funcall b (and (fboundp 'treesit-available-p) (treesit-available-p))))
      (sqlite . ,(funcall b (and (fboundp 'sqlite-available-p) (sqlite-available-p))))
      (libxml2 . ,(funcall b (and (fboundp 'libxml-available-p) (libxml-available-p))))
      (gnutls . ,(funcall b (and (fboundp 'gnutls-available-p) (gnutls-available-p))))
      (lcms2 . ,(funcall b (and (fboundp 'lcms2-available-p) (lcms2-available-p))))
      (modules . ,(funcall b (and (boundp 'module-file-suffix) module-file-suffix))))))))
(terpri)))
