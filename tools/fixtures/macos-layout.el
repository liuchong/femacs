;;; macos-layout.el --- Native frame geometry acceptance -*- lexical-binding: t; -*-

(require 'json)
(setq inhibit-startup-screen t initial-scratch-message nil)
(defvar femacs-layout-report (getenv "FEMACS_LAYOUT_REPORT"))
(defvar femacs-layout-action "initial")
(defvar femacs-layout-buffer (get-buffer-create "*layout-verification*"))
(modify-frame-parameters nil '((name . "Femacs — layout verification")
                               (left . 500) (top . 80) (width . 65) (height . 28)))
(switch-to-buffer femacs-layout-buffer)
(insert "Femacs macOS 窗口布局验证\n\n")
(dotimes (i 60)
  (insert (format "%02d  编辑区应填满窗口；中文与 English，🙂\n" i)))
(goto-char (point-min))
(set-buffer-modified-p nil)
(defun femacs-layout-resize (width height action)
  (setq femacs-layout-action action)
  (set-frame-size (selected-frame) width height))
(global-set-key (kbd "C-c 1") (lambda () (interactive) (femacs-layout-resize 65 28 "65x28")))
(global-set-key (kbd "C-c 2") (lambda () (interactive) (femacs-layout-resize 85 35 "85x35")))
(global-set-key (kbd "C-c 3") (lambda () (interactive) (femacs-layout-resize 50 20 "50x20")))
(global-set-key (kbd "C-c 4")
                (lambda () (interactive) (setq femacs-layout-action "tab-bar") (tab-bar-mode 'toggle)))
(defun femacs-layout-snapshot ()
  (when femacs-layout-report
    (let ((record
           `((pid . ,(emacs-pid)) (action . ,femacs-layout-action)
             (buffer . ,(buffer-name)) (point . ,(point))
             (line-beginning . ,(line-beginning-position)) (line-end . ,(line-end-position))
             (frame-size . ,(vector (frame-pixel-width) (frame-pixel-height)))
             (columns-lines . ,(vector (frame-width) (frame-height)))
             (window-edges . ,(vconcat (window-pixel-edges)))
             (text-edges . ,(vconcat (window-inside-pixel-edges)))
             (minibuffer-edges . ,(vconcat (window-pixel-edges (minibuffer-window))))
             (tab-bar-lines . ,(frame-parameter nil 'tab-bar-lines))
             (name . ,(frame-parameter nil 'name)))))
      (with-temp-file femacs-layout-report (insert (json-encode record))))))
(run-with-timer 0.2 0.2 #'femacs-layout-snapshot)
