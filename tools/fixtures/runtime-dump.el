;;; runtime-dump.el --- Owned native/collector image cases -*- lexical-binding: t; -*-
;; Definitions only. The final driver calls prepare and assert in DIFFERENT
;; fresh processes, passing the actual generated image through --dump-file.

(defvar femacs-runtime-dump-function nil)
(defvar femacs-runtime-dump-vector nil)
(defvar femacs-runtime-dump-cons nil)
(defvar femacs-runtime-dump-native-file nil)
(defvar femacs-runtime-dump-native-sha256 nil)

(defun femacs-runtime-dump-native-identity ()
  (unless (and (stringp femacs-runtime-dump-native-file)
               (file-regular-p femacs-runtime-dump-native-file)
               (> (file-attribute-size
                   (file-attributes femacs-runtime-dump-native-file)) 0))
    (error "Persistent native dump unit is missing or empty"))
  (with-temp-buffer
    (set-buffer-multibyte nil)
    (insert-file-contents-literally femacs-runtime-dump-native-file)
    (secure-hash 'sha256 (current-buffer))))

(defun femacs-runtime-dump-root ()
  (let ((root (getenv "FEMACS_RUNTIME_TEST_ROOT")))
    (unless (and root (file-directory-p root))
      (error "Existing owned FEMACS_RUNTIME_TEST_ROOT required"))
    (file-name-as-directory (file-truename root))))

(defun femacs-runtime-dump-file ()
  (expand-file-name "runtime-image.pdmp" (femacs-runtime-dump-root)))

(defun femacs-runtime-dump-report (phase observations)
  (require 'json)
  (let ((path (expand-file-name (concat "dump-" phase ".json") (femacs-runtime-dump-root))))
    (with-temp-file path
      (insert (json-serialize (vector 1 phase observations))))))

(defun femacs-runtime-dump-prepare ()
  (when (file-exists-p (femacs-runtime-dump-file))
    (error "Fresh image output required"))
  (setq femacs-runtime-dump-vector (vector nil)
        femacs-runtime-dump-cons (cons nil nil))
  (when (equal (getenv "FEMACS_RUNTIME_NATIVE_REQUIRED") "1")
    (require 'comp)
    (let* ((root (femacs-runtime-dump-root))
           (default-directory root)
           (temporary-file-directory (expand-file-name "tmp/" root))
           (native-comp-eln-load-path (list (expand-file-name "eln/" root)))
           (comp-running-batch-compilation t))
      (make-directory temporary-file-directory t)
      (make-directory (car native-comp-eln-load-path) t)
      ;; Anonymous compilation without OUTPUT intentionally deletes its
      ;; temporary ELN.  A dumped native function needs an explicit owned unit
      ;; that still exists when process2 restores the image.
      (setq femacs-runtime-dump-native-file (expand-file-name "dump-native.eln" root))
      (when (file-exists-p femacs-runtime-dump-native-file)
        (error "Fresh persistent native unit required"))
      (setq femacs-runtime-dump-function
            (native-compile
             '(lambda (number)
                (let ((pair (cons number "中文")))
                  (garbage-collect)
                  (list (1+ (car pair)) (cdr pair) '(:constant 7))))
             femacs-runtime-dump-native-file)
            femacs-runtime-dump-native-sha256 (femacs-runtime-dump-native-identity))
      (unless (native-comp-function-p femacs-runtime-dump-function)
        (error "Native dump candidate did not compile a native function"))
      (unless (equal (funcall femacs-runtime-dump-function 41) '(42 "中文" (:constant 7)))
        (error "Pre-dump native observation differs"))))
  (garbage-collect)
  (dump-emacs-portable (femacs-runtime-dump-file))
  (femacs-runtime-dump-report "prepared" (vector (femacs-runtime-dump-file))))

(defun femacs-runtime-dump-until-minor ()
  (unless (fboundp 'femacs--gc-collector-status)
    (error "Collector profile missing actual status"))
  (let* ((status (femacs--gc-collector-status))
         (before (aref (aref status 1) 4))
         (young (= (aref (aref status 1) 0) 1))
         (attempt 0)
         (found nil))
    (if young
        (progn
          (while (and (< attempt 16) (not found))
            (let ((gc-cons-threshold 30000) (gc-cons-percentage 0.0) (scratch nil))
              (dotimes (i 4000) (setq scratch (cons i scratch)))
              (setq scratch nil))
            (setq found (> (aref (aref (femacs--gc-collector-status) 1) 4) before)
                  attempt (1+ attempt)))
          (unless found (error "Restored collector did not exercise a minor")))
      (garbage-collect))
    (femacs--gc-collector-status)))

(defun femacs-runtime-dump-assert ()
  (let* ((stats (pdumper-stats))
         (loaded (cdr (assq 'dump-file-name stats))))
    (unless (and (cdr (assq 'dumped-with-pdumper stats))
                 (stringp loaded)
                 (equal (file-truename loaded) (file-truename (femacs-runtime-dump-file))))
      (error "Requested new image was not actually loaded")))
  (when (equal (getenv "FEMACS_RUNTIME_NATIVE_REQUIRED") "1")
    (unless (equal (femacs-runtime-dump-native-identity)
                   femacs-runtime-dump-native-sha256)
      (error "Persistent native unit changed across image restore"))
    (unless (native-comp-function-p femacs-runtime-dump-function)
      (error "Image lost the actual native function"))
    (unless (equal (funcall femacs-runtime-dump-function 41) '(42 "中文" (:constant 7)))
      (error "Restored native observation differs")))
  (when (equal (getenv "FEMACS_RUNTIME_COLLECTOR_REQUIRED") "1")
    (let ((holder (cons femacs-runtime-dump-vector nil)))
      (setq femacs-runtime-dump-vector nil)
      (garbage-collect)
      (aset (car holder) 0 (list :young-vector "中文"))
      (femacs-runtime-dump-until-minor)
      (unless (equal (aref (car holder) 0) '(:young-vector "中文"))
        (error "Old heap parent lost young child through dumped vector")))
    (let ((holder (cons femacs-runtime-dump-cons nil)))
      (setq femacs-runtime-dump-cons nil)
      (garbage-collect)
      (setcar (car holder) (list :young-cons "中文"))
      (femacs-runtime-dump-until-minor)
      (unless (equal (car (car holder)) '(:young-cons "中文"))
        (error "Old heap parent lost young child through dumped cons"))))
  (femacs-runtime-dump-report "restored" (vector "native-and-collector-profile-observations-complete")))

;;; runtime-dump.el ends here
