;;; runtime-symbol-intern-functional.el --- String interning vs reader shorthands functional checks -*- lexical-binding: t; -*-

(require 'cl-lib)
;; This preloaded library defines functions without providing a feature.
(load "shorthands" nil t)

(defconst rsi--defined-symbols
  '(rsi--require
    rsi--temp-def-macro
    rsi--case-literal-string-intern-coexistence
    rsi--case-reader-token-shorthand-vs-string-intern
    rsi--case-explicit-shorthands-api-contract
    rsi--case-multibyte-and-non-ascii-contract
    rsi--case-symbol-argument-exact-identity
    rsi--case-macro-generated-symbol-call-and-gc-survival
    rsi--run-suite
    rsi--defined-symbols))

(defun rsi--require (condition fmt &rest args)
  "Signal an uncaught error when CONDITION is nil."
  (unless condition
    (error "%s" (apply #'format fmt args))))

(defun rsi--case-literal-string-intern-coexistence ()
  "Verify literal string `intern', `intern-soft', and `unintern' under shorthands."
  (let* ((ob (obarray-make 32))
         (read-symbol-shorthands '(("ical-" . "icalendar-")
                                   ("t-" . "test-longhand-")))
         (short-name "ical-parser--case-1")
         (long-name "icalendar-parser--case-1"))
    (rsi--require (null (intern-soft short-name ob))
                  "rsi01: expected %S absent before intern" short-name)
    (rsi--require (null (intern-soft long-name ob))
                  "rsi01: expected %S absent before intern" long-name)
    (let ((short-sym (intern short-name ob))
          (short-sym-2 (intern (concat "ical-" "parser--case-1") ob)))
      (rsi--require (symbolp short-sym)
                    "rsi01: expected symbol from intern, got %S" short-sym)
      (rsi--require (equal (symbol-name short-sym) short-name)
                    "rsi01: expected literal symbol-name %S, got %S"
                    short-name (symbol-name short-sym))
      (rsi--require (eq short-sym short-sym-2)
                    "rsi01: repeated intern of %S did not return identical symbol"
                    short-name)
      (rsi--require (eq (intern-soft short-name ob) short-sym)
                    "rsi01: intern-soft did not find literal %S" short-name)
      (rsi--require (null (intern-soft long-name ob))
                    "rsi01: literal intern of %S unexpectedly populated longhand %S"
                    short-name long-name)
      (let ((long-sym (intern long-name ob)))
        (rsi--require (not (eq short-sym long-sym))
                      "rsi01: short and long symbols must be distinct in obarray")
        (rsi--require (equal (symbol-name long-sym) long-name)
                      "rsi01: unexpected long symbol-name %S" (symbol-name long-sym))
        (rsi--require (eq (intern-soft short-name ob) short-sym)
                      "rsi01: short symbol lost after interning long symbol")
        (rsi--require (eq (intern-soft long-name ob) long-sym)
                      "rsi01: long symbol lookup failed")
        (rsi--require (eq (unintern short-name ob) t)
                      "rsi01: unintern of literal %S did not return t" short-name)
        (rsi--require (null (intern-soft short-name ob))
                      "rsi01: %S still present after unintern" short-name)
        (rsi--require (eq (intern-soft long-name ob) long-sym)
                      "rsi01: unintern of %S disturbed coexisting %S"
                      short-name long-name)
        (rsi--require (null (unintern short-name ob))
                      "rsi01: second unintern of %S should return nil" short-name)
        (rsi--require (eq (unintern long-name ob) t)
                      "rsi01: unintern of %S did not return t" long-name)
        (rsi--require (null (intern-soft long-name ob))
                      "rsi01: %S still present after unintern" long-name))))
  'rsi01-literal-string-intern-coexistence)

(defun rsi--case-reader-token-shorthand-vs-string-intern ()
  "Verify reader symbol tokens still expand while string `intern' stays literal."
  (let* ((ob (obarray-make 32))
         (read-symbol-shorthands '(("ical-" . "icalendar-")
                                   ("p-" . "pkg-namespace--")))
         (read-sym (let ((obarray ob))
                     (car (read-from-string "ical-entry"))))
         (read-form (let ((obarray ob))
                      (with-temp-buffer
                        (insert "(p-worker ical-entry \"ical-entry\")")
                        (goto-char (point-min))
                        (read (current-buffer)))))
         (literal-sym (intern "ical-entry" ob)))
    (rsi--require (equal (symbol-name read-sym) "icalendar-entry")
                  "rsi02: reader symbol token did not expand: %S"
                  (symbol-name read-sym))
    (rsi--require (eq (intern-soft "icalendar-entry" ob) read-sym)
                  "rsi02: reader symbol not interned under expanded name in obarray")
    (rsi--require (equal (symbol-name (nth 0 read-form)) "pkg-namespace--worker")
                  "rsi02: reader list head did not expand: %S" (nth 0 read-form))
    (rsi--require (eq (nth 1 read-form) read-sym)
                  "rsi02: reader symbol identity mismatch across read calls")
    (rsi--require (equal (nth 2 read-form) "ical-entry")
                  "rsi02: reader string literal was altered: %S" (nth 2 read-form))
    (rsi--require (equal (symbol-name literal-sym) "ical-entry")
                  "rsi02: literal intern changed name: %S" (symbol-name literal-sym))
    (rsi--require (not (eq read-sym literal-sym))
                  "rsi02: reader expanded symbol and literal intern symbol collided")
    (rsi--require (eq (intern-soft "ical-entry" ob) literal-sym)
                  "rsi02: literal symbol lookup failed in obarray")
    (rsi--require (eq (intern-soft "icalendar-entry" ob) read-sym)
                  "rsi02: expanded symbol lookup failed in obarray"))
  'rsi02-reader-token-shorthand-vs-string-intern)

(defun rsi--case-explicit-shorthands-api-contract ()
  "Verify explicit `shorthands-intern', `shorthands-intern-soft', and `shorthands-unintern'."
  (let* ((ob (obarray-make 32))
         (read-symbol-shorthands '(("sh-" . "shorthand-target--")
                                   ("alt-" . "alternate-target--"))))
    (rsi--require (equal (shorthands-to-longhand "sh-action")
                         "shorthand-target--action")
                  "rsi03: unexpected shorthands-to-longhand result")
    (rsi--require (equal (shorthands-to-longhand "unmatched-action")
                         "unmatched-action")
                  "rsi03: unmatched string altered by shorthands-to-longhand")
    (rsi--require (null (shorthands-intern-soft "sh-action" ob))
                  "rsi03: shorthands-intern-soft should be nil before intern")
    (let ((expanded-sym (shorthands-intern "sh-action" ob))
          (literal-sym (intern "sh-action" ob)))
      (rsi--require (equal (symbol-name expanded-sym) "shorthand-target--action")
                    "rsi03: shorthands-intern did not expand name: %S"
                    (symbol-name expanded-sym))
      (rsi--require (equal (symbol-name literal-sym) "sh-action")
                    "rsi03: ordinary intern did not stay literal: %S"
                    (symbol-name literal-sym))
      (rsi--require (not (eq expanded-sym literal-sym))
                    "rsi03: shorthands-intern and ordinary intern collided")
      (rsi--require (eq (shorthands-intern-soft "sh-action" ob) expanded-sym)
                    "rsi03: shorthands-intern-soft did not return expanded symbol")
      (rsi--require (eq (intern-soft "shorthand-target--action" ob) expanded-sym)
                    "rsi03: intern-soft of longhand did not return expanded symbol")
      (rsi--require (eq (intern-soft "sh-action" ob) literal-sym)
                    "rsi03: intern-soft of shorthand did not return literal symbol")
      (rsi--require (equal (shorthands-of-symbol expanded-sym) '("sh-action"))
                    "rsi03: unexpected shorthands-of-symbol result: %S"
                    (shorthands-of-symbol expanded-sym))
      (rsi--require (eq (shorthands-unintern "sh-action" ob) t)
                    "rsi03: shorthands-unintern did not return t")
      (rsi--require (null (shorthands-intern-soft "sh-action" ob))
                    "rsi03: expanded symbol still present after shorthands-unintern")
      (rsi--require (null (intern-soft "shorthand-target--action" ob))
                    "rsi03: longhand lookup still non-nil after shorthands-unintern")
      (rsi--require (eq (intern-soft "sh-action" ob) literal-sym)
                    "rsi03: shorthands-unintern disturbed literal symbol in obarray")))
  'rsi03-explicit-shorthands-api-contract)

(defun rsi--case-multibyte-and-non-ascii-contract ()
  "Verify multibyte/non-ASCII names and shorthand mappings follow the same contract."
  (let* ((ob (obarray-make 32))
         (read-symbol-shorthands '(("λ-" . "λ演算-模块--")
                                   ("日-" . "日历-解析--")))
         (lit-lambda (intern "λ-求值" ob))
         (lit-cal (intern "日-条目" ob))
         (read-lambda (let ((obarray ob))
                        (car (read-from-string "λ-求值"))))
         (sh-cal (shorthands-intern "日-条目" ob)))
    (rsi--require (and (multibyte-string-p (symbol-name lit-lambda))
                       (equal (symbol-name lit-lambda) "λ-求值"))
                  "rsi04: unexpected literal multibyte symbol name %S"
                  (symbol-name lit-lambda))
    (rsi--require (and (multibyte-string-p (symbol-name read-lambda))
                       (equal (symbol-name read-lambda) "λ演算-模块--求值"))
                  "rsi04: unexpected reader multibyte symbol name %S"
                  (symbol-name read-lambda))
    (rsi--require (equal (symbol-name lit-cal) "日-条目")
                  "rsi04: unexpected literal calendar multibyte name %S"
                  (symbol-name lit-cal))
    (rsi--require (equal (symbol-name sh-cal) "日历-解析--条目")
                  "rsi04: unexpected shorthands-intern multibyte name %S"
                  (symbol-name sh-cal))
    (rsi--require (not (eq lit-lambda read-lambda))
                  "rsi04: multibyte literal and reader symbols collided")
    (rsi--require (not (eq lit-cal sh-cal))
                  "rsi04: multibyte literal and shorthands-intern symbols collided")
    (rsi--require (eq (intern-soft "λ-求值" ob) lit-lambda)
                  "rsi04: multibyte literal lookup failed")
    (rsi--require (eq (intern-soft "λ演算-模块--求值" ob) read-lambda)
                  "rsi04: multibyte expanded lookup failed")
    (rsi--require (eq (shorthands-intern-soft "日-条目" ob) sh-cal)
                  "rsi04: multibyte shorthands-intern-soft failed")
    (rsi--require (eq (unintern "λ-求值" ob) t)
                  "rsi04: multibyte literal unintern failed")
    (rsi--require (null (intern-soft "λ-求值" ob))
                  "rsi04: multibyte literal remained after unintern")
    (rsi--require (eq (intern-soft "λ演算-模块--求值" ob) read-lambda)
                  "rsi04: multibyte expanded symbol disturbed by literal unintern")
    (rsi--require (eq (shorthands-unintern "日-条目" ob) t)
                  "rsi04: multibyte shorthands-unintern failed")
    (rsi--require (null (intern-soft "日历-解析--条目" ob))
                  "rsi04: multibyte shorthands target remained after unintern")
    (rsi--require (eq (intern-soft "日-条目" ob) lit-cal)
                  "rsi04: multibyte literal disturbed by shorthands-unintern"))
  'rsi04-multibyte-and-non-ascii-contract)

(defun rsi--case-symbol-argument-exact-identity ()
  "Verify symbol arguments to `intern-soft' and `unintern' require exact identity."
  (let* ((ob (obarray-make 32))
         (foreign-ob (obarray-make 32))
         (read-symbol-shorthands '(("s-" . "symbol-long--")))
         (local-short (intern "s-item" ob))
         (local-long (intern "symbol-long--item" ob))
         (uninterned-same (make-symbol "s-item"))
         (foreign-same (intern "s-item" foreign-ob))
         (foreign-long (intern "symbol-long--item" foreign-ob)))
    (rsi--require (null (intern-soft uninterned-same ob))
                  "rsi05: uninterned symbol matched in obarray")
    (rsi--require (null (intern-soft foreign-same ob))
                  "rsi05: foreign-obarray short symbol matched in obarray")
    (rsi--require (null (intern-soft foreign-long ob))
                  "rsi05: foreign-obarray long symbol matched in obarray")
    (rsi--require (null (unintern uninterned-same ob))
                  "rsi05: unintern of uninterned symbol returned non-nil")
    (rsi--require (null (unintern foreign-same ob))
                  "rsi05: unintern of foreign short symbol returned non-nil")
    (rsi--require (null (unintern foreign-long ob))
                  "rsi05: unintern of foreign long symbol returned non-nil")
    (rsi--require (eq (intern-soft local-short ob) local-short)
                  "rsi05: intern-soft with local-short symbol failed under shorthands")
    (rsi--require (eq (intern-soft local-long ob) local-long)
                  "rsi05: intern-soft with local-long symbol failed under shorthands")
    (rsi--require (eq (unintern local-short ob) t)
                  "rsi05: unintern with local-short symbol did not return t")
    (rsi--require (null (intern-soft local-short ob))
                  "rsi05: local-short still found by symbol after unintern")
    (rsi--require (null (intern-soft "s-item" ob))
                  "rsi05: local-short still found by string after unintern")
    (rsi--require (eq (intern-soft local-long ob) local-long)
                  "rsi05: unintern of local-short disturbed local-long")
    (rsi--require (eq (intern-soft foreign-same foreign-ob) foreign-same)
                  "rsi05: foreign-ob symbol was disturbed"))
  'rsi05-symbol-argument-exact-identity)

(defmacro rsi--temp-def-macro (suffix base-val)
  "Generate a literal-named function symbol via `intern' and a peer via `shorthands-intern'."
  (let ((fn-sym (intern (concat "ical-generated-fn--" suffix)))
        (peer-sym (shorthands-intern (concat "ical-generated-fn--" suffix))))
    `(progn
       (put ',fn-sym 'rsi-tag ,suffix)
       (fset ',fn-sym
             (lambda (delta)
               (list ',fn-sym
                     (symbol-name ',fn-sym)
                     (get ',fn-sym 'rsi-tag)
                     (+ ,base-val delta))))
       (put ',peer-sym 'rsi-peer-of ',fn-sym)
       (list ',fn-sym ',peer-sym))))

(defun rsi--case-macro-generated-symbol-call-and-gc-survival ()
  "Verify macro-generated `intern' symbols retain literal name, callable state, and survive GC."
  (let* ((ob (obarray-make 32))
         (read-symbol-shorthands '(("ical-" . "icalendar-")
                                   ("m-" . "macro-expanded--")))
         (pair (let ((obarray ob))
                 (eval (macroexpand '(rsi--temp-def-macro "alpha" 40)) t)))
         (fn-sym (car pair))
         (peer-sym (cadr pair))
         (pre-gc-call (funcall (symbol-function fn-sym) 2)))
    (rsi--require (null (intern-soft "ical-generated-fn--alpha" obarray))
                  "rsi06: macro leaked literal symbol into global obarray")
    (rsi--require (null (intern-soft "icalendar-generated-fn--alpha" obarray))
                  "rsi06: macro leaked peer symbol into global obarray")
    (rsi--require (eq fn-sym (intern-soft "ical-generated-fn--alpha" ob))
                  "rsi06: macro-generated symbol not registered under literal name")
    (rsi--require (equal (symbol-name fn-sym) "ical-generated-fn--alpha")
                  "rsi06: macro-generated symbol name was shorthand-expanded: %S"
                  (symbol-name fn-sym))
    (rsi--require (eq peer-sym (intern-soft "icalendar-generated-fn--alpha" ob))
                  "rsi06: peer shorthands-intern symbol missing from obarray")
    (rsi--require (not (eq fn-sym peer-sym))
                  "rsi06: macro-generated literal symbol and peer collided")
    (rsi--require (equal pre-gc-call
                         (list fn-sym "ical-generated-fn--alpha" "alpha" 42))
                  "rsi06: unexpected pre-GC macro function return value %S"
                  pre-gc-call)
    (garbage-collect)
    (let ((post-gc-sym (intern-soft "ical-generated-fn--alpha" ob))
          (post-gc-peer (intern-soft "icalendar-generated-fn--alpha" ob))
          (post-gc-call (funcall (symbol-function fn-sym) 9)))
      (rsi--require (eq post-gc-sym fn-sym)
                    "rsi06: macro-generated symbol lost identity after GC")
      (rsi--require (eq post-gc-peer peer-sym)
                    "rsi06: peer symbol lost identity after GC")
      (rsi--require (eq (get post-gc-sym 'rsi-peer-of) nil)
                    "rsi06: unexpected rsi-peer-of on literal symbol")
      (rsi--require (eq (get post-gc-peer 'rsi-peer-of) fn-sym)
                    "rsi06: peer plist reference lost after GC")
      (rsi--require (equal post-gc-call
                           (list fn-sym "ical-generated-fn--alpha" "alpha" 49))
                    "rsi06: unexpected post-GC macro function return value %S"
                    post-gc-call)))
  'rsi06-macro-generated-symbol-call-and-gc-survival)

(defun rsi--run-suite ()
  "Run all P466 symbol interning functional cases and print pass marker."
  (let ((passed
         (list
          (rsi--case-literal-string-intern-coexistence)
          (rsi--case-reader-token-shorthand-vs-string-intern)
          (rsi--case-explicit-shorthands-api-contract)
          (rsi--case-multibyte-and-non-ascii-contract)
          (rsi--case-symbol-argument-exact-identity)
          (rsi--case-macro-generated-symbol-call-and-gc-survival))))
    (let ((result (list 'P466-SYMBOL-INTERN passed)))
      (prin1 result)
      (terpri)
      result)))

(unwind-protect
    (rsi--run-suite)
  (let ((syms rsi--defined-symbols))
    (dolist (sym syms)
      (when (fboundp sym)
        (fmakunbound sym))
      (when (boundp sym)
        (makunbound sym))
      (unintern sym obarray))))

;;; runtime-symbol-intern-functional.el ends here
