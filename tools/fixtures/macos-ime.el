;;; macos-ime.el --- Real system IME acceptance -*- lexical-binding: t; -*-
(setq inhibit-startup-screen t initial-scratch-message nil)
(defvar femacs-ime-buffer (get-buffer-create "*femacs-ime-acceptance*"))
(defvar femacs-ime-report (getenv "FEMACS_IME_REPORT"))
(defvar femacs-ime-second-buffer nil)
(defvar femacs-ime-first-frame (selected-frame))
(modify-frame-parameters nil '((name . "Femacs IME A")))
(when (getenv "FEMACS_IME_MULTIFRAME")
  (modify-frame-parameters nil '((name . "Femacs IME A") (left . 40) (top . 60)
                                 (width . 60) (height . 25)))
  (setq femacs-ime-second-buffer (get-buffer-create "*femacs-ime-second*"))
  (let ((second (make-frame '((name . "Femacs IME B") (left . 700) (top . 60)
                              (width . 60) (height . 25)))))
    (set-window-buffer (frame-selected-window second) femacs-ime-second-buffer))
  ;; make-frame may select the new frame; populate A without overwriting B.
  (select-frame-set-input-focus femacs-ime-first-frame))
(switch-to-buffer femacs-ime-buffer)
(erase-buffer)
(set-buffer-modified-p nil)
(defun femacs-ime-snapshot ()
  (let ((record
         (with-current-buffer femacs-ime-buffer
           `((text . ,(buffer-substring-no-properties (point-min) (point-max)))
             (working . ,(if (boundp 'ns-working-text) ns-working-text ""))
             (marked . ,(if (and (boundp 'ns-working-overlay) ns-working-overlay) t :json-false))
             (minibuffer . ,(if (active-minibuffer-window) t :json-false))
             (selected . ,(frame-parameter (selected-frame) 'name))
             (second_text . ,(if (buffer-live-p femacs-ime-second-buffer)
                                 (with-current-buffer femacs-ime-second-buffer
                                   (buffer-substring-no-properties (point-min) (point-max))) ""))
             (native . ,(symbol-name window-system))))))
    (with-temp-file femacs-ime-report (insert (json-encode record)))))
(require 'json)
(run-with-timer 0.1 0.1 #'femacs-ime-snapshot)
