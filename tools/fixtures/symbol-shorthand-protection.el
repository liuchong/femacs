;;; symbol-shorthand-protection.el --- stable string-interface guards -*- lexical-binding: t; -*-

(require 'ert)
(require 'cl-lib)
(require 'json)

(ert-deftest fe-shorthand-existing-longhand-and-first-match ()
  (let* ((oa (obarray-make))
         (target (intern "Long•tail" oa))
         (other (intern "Other•tail" oa))
         (read-symbol-shorthands
          '("ignored" (2 . "ignored")
            ("q·" . "Long•") ("q·" . "Other•"))))
    ;; Repeated hits must return the existing symbol, without duplicating it.
    ;; This checks identity, not allocator accounting or exceptional unwinding.
    (dotimes (_ 32)
      (should (eq (intern "q·tail" oa) target)))
    (should (eq (intern-soft "q·tail" oa) target))
    (should (eq (intern-soft "Long•tail" oa) target))
    (let ((count 0))
      (mapatoms (lambda (_) (cl-incf count)) oa)
      (should (= count 2)))
    (should (unintern "q·tail" oa))
    (should-not (intern-soft "q·tail" oa))
    (should-not (intern-soft "Long•tail" oa))
    (should (eq (intern-soft "Other•tail" oa) other))))

(ert-deftest fe-shorthand-symbol-identity-and-dynamic-extent ()
  (let* ((oa (obarray-make))
         (raw (intern "q·tail" oa))
         (long nil))
    (let ((read-symbol-shorthands '(("q·" . "Long•"))))
      (setq long (intern "q·tail" oa))
      (should-not (eq raw long))
      (should (equal (symbol-name long) "Long•tail"))
      (should (eq (intern-soft raw oa) raw))
      (should (eq (intern-soft long oa) long))
      (should (unintern raw oa))
      (should-not (intern-soft raw oa))
      (should (eq (intern-soft "q·tail" oa) long)))
    ;; Leaving the dynamic binding must restore literal string lookup.
    (should-not (intern-soft "q·tail" oa))
    (should (eq (intern-soft "Long•tail" oa) long))
    (let ((replacement (intern "q·tail" oa)))
      (should-not (eq replacement raw))
      (should-not (eq replacement long))
      (should (equal (symbol-name replacement) "q·tail")))))

(defun fe-shorthand-protection-run ()
  "Write per-case ERT results to FE_SHORTHAND_RESULT."
  (dolist (function '(intern intern-soft unintern))
    (unless (subrp (symbol-function function))
      (error "Expected native primitive: %s" function)))
  (let ((rows nil)
        (selector (if (getenv "FE_SHORTHAND_SELECTOR")
                      (intern (getenv "FE_SHORTHAND_SELECTOR")) "^fe-shorthand-")))
    (ert-run-tests
     selector
     (lambda (event &rest args)
       (when (eq event 'test-ended)
         (let ((test (nth 1 args)) (result (nth 2 args)))
           (push (list (cons "id" (symbol-name (ert-test-name test)))
                       (cons "status" (cond ((ert-test-result-type-p result :passed) "passed")
                                             ((ert-test-result-type-p result :skipped) "skipped")
                                             (t "failed")))
                       (cons "seconds" (ert-test-result-duration result))
                       (cons "condition" (and (ert-test-result-with-condition-p result)
                                              (prin1-to-string
                                               (ert-test-result-with-condition-condition result)))))
                 rows)))))
    (setq rows (nreverse rows))
    (let* ((passed (and rows (cl-every (lambda (row) (equal (cdr (assoc "status" row)) "passed")) rows)))
           (coding-system-for-write 'utf-8-unix))
      (with-temp-file (or (getenv "FE_SHORTHAND_RESULT") (error "FE_SHORTHAND_RESULT is required"))
        (insert (json-encode (list (cons "passed" (if passed t :json-false))
                                  (cons "cases" (vconcat rows)))) "\n"))
      (kill-emacs (if passed 0 1)))))
