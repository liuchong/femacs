;;; symbol-shorthand-protection.el --- literal string-interning guards -*- lexical-binding: t; -*-

(require 'ert)
(require 'cl-lib)
(require 'json)
;; Preloaded shorthands.el defines explicit helpers without providing a feature.
(load "shorthands" nil t)

(defun fe-shorthand--atom-count (oa)
  "Return the number of interned symbols in obarray OA."
  (let ((count 0))
    (mapatoms (lambda (_) (cl-incf count)) oa)
    count))

(ert-deftest fe-shorthand-literal-string-and-dynamic-extent ()
  (let* ((oa (obarray-make))
         (target (intern "Long•tail" oa))
         (other (intern "Other•tail" oa))
         (literal nil))
    (let ((read-symbol-shorthands
           '("ignored" (2 . "ignored")
             ("q·" . "Long•") ("q·" . "Other•"))))
      ;; String APIs use exact oblookup even while shorthands are dynamically bound.
      (setq literal (intern "q·tail" oa))
      (dotimes (_ 32)
        (should (eq (intern "q·tail" oa) literal)))
      (should (equal (symbol-name literal) "q·tail"))
      (should-not (eq literal target))
      (should-not (eq literal other))
      (should (eq (intern-soft "q·tail" oa) literal))
      (should (eq (intern-soft "Long•tail" oa) target))
      (should (eq (intern-soft "Other•tail" oa) other))
      (should (= (fe-shorthand--atom-count oa) 3))
      (should (eq (unintern "q·tail" oa) t))
      (should-not (unintern "q·tail" oa))
      (should-not (intern-soft "q·tail" oa))
      (should (eq (intern-soft "Long•tail" oa) target))
      (should (eq (intern-soft "Other•tail" oa) other))
      (setq literal (intern "q·tail" oa)))
    ;; Leaving the dynamic binding preserves exact literal identity and membership.
    (should (eq (intern-soft "q·tail" oa) literal))
    (should (eq (intern-soft "Long•tail" oa) target))
    (should (eq (intern-soft "Other•tail" oa) other))
    (should (= (fe-shorthand--atom-count oa) 3))))

(ert-deftest fe-shorthand-reader-and-explicit-helpers-expand ()
  (let* ((oa (obarray-make))
         (read-symbol-shorthands
          '(("q·" . "Long•") ("q·" . "Other•")))
         (literal (intern "q·tail" oa))
         (from-reader (let ((obarray oa))
                        (car (read-from-string "q·reader"))))
         (from-helper (shorthands-intern "q·tail" oa)))
    (should (equal (symbol-name literal) "q·tail"))
    (should (equal (symbol-name from-reader) "Long•reader"))
    (should (equal (symbol-name from-helper) "Long•tail"))
    (should-not (eq literal from-helper))
    (should (eq (intern-soft "q·tail" oa) literal))
    (should (eq (intern-soft "Long•reader" oa) from-reader))
    (should-not (intern-soft "q·reader" oa))
    (should (eq (shorthands-intern-soft "q·tail" oa) from-helper))
    (should (eq (intern-soft "Long•tail" oa) from-helper))
    (should (= (fe-shorthand--atom-count oa) 3))
    (should (eq (shorthands-unintern "q·tail" oa) t))
    (should-not (shorthands-intern-soft "q·tail" oa))
    (should-not (intern-soft "Long•tail" oa))
    (should (eq (intern-soft "q·tail" oa) literal))))

(ert-deftest fe-shorthand-foreign-and-uninterned-symbol-identity ()
  (let* ((oa (obarray-make))
         (foreign-oa (obarray-make))
         (read-symbol-shorthands '(("q·" . "Long•")))
         (local-short (intern "q·same" oa))
         (local-long (intern "Long•same" oa))
         (foreign-short (intern "q·same" foreign-oa))
         (foreign-long (intern "Long•same" foreign-oa))
         (uninterned-short (make-symbol "q·same"))
         (uninterned-long (make-symbol "Long•same")))
    (dolist (alien (list foreign-short foreign-long uninterned-short uninterned-long))
      (should-not (intern-soft alien oa))
      (should-not (unintern alien oa)))
    (should (eq (intern-soft local-short oa) local-short))
    (should (eq (intern-soft local-long oa) local-long))
    (when (fboundp 'position-symbol)
      (let* ((symbols-with-pos-enabled t)
             (pos-local (position-symbol local-short 7))
             (pos-foreign (position-symbol foreign-short 7)))
        (should (symbol-with-pos-p (intern-soft pos-local oa)))
        (should (eq (bare-symbol (intern-soft pos-local oa)) local-short))
        (should-not (intern-soft pos-foreign oa))))
    (should (eq (unintern local-short oa) t))
    (should-not (intern-soft local-short oa))
    (should-not (intern-soft "q·same" oa))
    (should (eq (intern-soft local-long oa) local-long))
    (should (eq (intern-soft foreign-short foreign-oa) foreign-short))
    (should (eq (intern-soft foreign-long foreign-oa) foreign-long))))

(ert-deftest fe-shorthand-invalid-arguments-preserve-obarray ()
  (let* ((oa (obarray-make))
         (read-symbol-shorthands '(("q·" . "Long•")))
         (existing (intern "q·keep" oa)))
    ;; `intern' rejects symbols and non-strings; all three reject non-obarrays.
    (should-error (intern existing oa) :type 'wrong-type-argument)
    (should-error (intern 42 oa) :type 'wrong-type-argument)
    (should-error (intern-soft 42 oa) :type 'wrong-type-argument)
    (should-error (unintern 42 oa) :type 'wrong-type-argument)
    ;; C's check_obarray_slow accepts a vector whose first slot is 0 for
    ;; compatibility and stores an obarray object there, so only a vector whose
    ;; first slot is neither 0 nor an obarray is rejected.
    (let ((compat (vector 0 0)))
      ;; The symbol lands in the object stored in slot 0, so it is a symbol but
      ;; not the one interned in OA above.
      (should (symbolp (intern "q·keep" compat)))
      (should (obarrayp (aref compat 0))))
    (should-error (intern "q·keep" (vector 1 0)) :type 'wrong-type-argument)
    (should-error (intern-soft "q·keep" (vector 1 0)) :type 'wrong-type-argument)
    (should-error (unintern "q·keep" (vector 1 0)) :type 'wrong-type-argument)
    (should (eq (intern-soft "q·keep" oa) existing))
    (should (= (fe-shorthand--atom-count oa) 1))))

(defun fe-shorthand-protection-run ()
  "Write per-case ERT results to FE_SHORTHAND_RESULT."
  (dolist (function '(intern intern-soft unintern))
    (unless (subrp (symbol-function function))
      (error "Expected native primitive: %s" function)))
  (let ((rows nil)
        (selector (if (getenv "FE_SHORTHAND_SELECTOR")
                      (intern (getenv "FE_SHORTHAND_SELECTOR")) "^fe-shorthand-")))
    (ert-run-tests
     selector
     (lambda (event &rest args)
       (when (eq event 'test-ended)
         (let ((test (nth 1 args)) (result (nth 2 args)))
           (push (list (cons "id" (symbol-name (ert-test-name test)))
                       (cons "status" (cond ((ert-test-result-type-p result :passed) "passed")
                                             ((ert-test-result-type-p result :skipped) "skipped")
                                             (t "failed")))
                       (cons "seconds" (ert-test-result-duration result))
                       (cons "condition" (and (ert-test-result-with-condition-p result)
                                              (prin1-to-string
                                               (ert-test-result-with-condition-condition result)))))
                 rows)))))
    (setq rows (nreverse rows))
    (let* ((passed (and rows (cl-every (lambda (row) (equal (cdr (assoc "status" row)) "passed")) rows)))
           (coding-system-for-write 'utf-8-unix))
      (with-temp-file (or (getenv "FE_SHORTHAND_RESULT") (error "FE_SHORTHAND_RESULT is required"))
        (insert (json-encode (list (cons "passed" (if passed t :json-false))
                                  (cons "cases" (vconcat rows)))) "\n"))
      (kill-emacs (if passed 0 1)))))
