# One form per line; tools/differential.sh runs each in both programs and compares the bytes.
# They avoid `emacs-version`, subr doc strings and anything display-dependent (see tools/smoke.sh).
(princ (list 1 2 3))
(princ (with-temp-buffer (insert "abc") (buffer-string)))
(princ (mapcar (function 1+) (list 1 2 3)))
(princ (sort (list 3 1 2) (function <)))
(princ (string-match "a*b" "aaab"))
(princ (replace-regexp-in-string "x+" "-" "axxbxx"))
(princ (let ((case-fold-search t)) (string-match-p "gb2312\\|gbk" "GB2312")))
(princ (let ((case-fold-search t)) (string-match-p "a.c" "axc")))
(princ (string-match "\\`foo" "foo bar"))
(princ (match-string 0 "foo bar" ))
(princ (with-temp-buffer (insert "a1b22c333") (goto-char 1) (re-search-forward "[0-9]+") (match-string 0)))
(princ (format "%s|%d|%S|%c" "x" 42 '(a b) 65))
(princ (number-to-string (/ 10 4.0)))
(princ (list (floor 2.5) (ceiling 2.5) (round 2.5) (truncate -2.5)))
(princ (expt 2 70))
(princ (+ most-positive-fixnum 1))
(princ (list (char-to-string 233) (string-to-char "é")))
(princ (length (string-to-list "日本語")))
(princ (encode-coding-string "é" 'utf-8))
(princ (decode-coding-string "\303\251" 'utf-8))
(princ (let ((h (make-hash-table :test 'equal))) (puthash "k" 1 h) (gethash "k" h)))
(princ (let ((tbl (make-char-table 'case-table))) (set-char-table-range tbl 65 97) (aref tbl 65)))
(princ (with-temp-buffer (insert "hello") (put-text-property 1 3 'face 'bold) (get-text-property 1 'face)))
(princ (with-temp-buffer (insert "abc") (let ((o (make-overlay 1 2))) (overlay-start o))))
(princ (with-temp-buffer (insert "abc") (undo-boundary) (insert "d") (undo) (buffer-string)))
(princ (let ((x (list 1 2 3))) (setcar x 9) x))
(princ (prin1-to-string "a\nb"))
(princ (json-serialize '((a . 1) (b . "x"))))
(princ (json-parse-string "{\"a\":[1,2],\"b\":null}"))
(princ (list (float-time '(0 0 0 0)) (time-equal-p '(1 2) '(1 2))))
(princ (format-time-string "%Y" 0 t))
(princ (string-join (list "a" "b" "c") "-"))
(princ (split-string "a,b,,c" ","))
(princ (string-pad "7" 3 ?0))
(princ (upcase "straße"))
(princ (downcase "ÄÖÜ"))
(princ (list (string> "b" "a") (string= "a" "a") (string< "a" "b")))
(princ (seq-filter #'cl-oddp (list 1 2 3 4)))
(princ (cl-loop for i from 1 to 3 collect (* i i)))
(princ (condition-case e (car 1) (error (car e))))
(princ (condition-case nil (error "boom %d" 7) (error (error-message-string nil))))
(princ (let ((s (make-string 3 ?x))) (aset s 1 ?y) s))
(princ (apply #'+ (list 1 2 3)))
(princ (funcall (lambda (a &optional b) (list a b)) 1))
(princ (let ((v (vector 1 2 3))) (aset v 0 'a) v))
(princ (append '(1 2) '(3) nil))
(princ (nreverse (list 1 2 3)))
(princ (assq 'b '((a . 1) (b . 2))))
(princ (mapconcat #'identity '("a" "b") ","))
