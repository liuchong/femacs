+fn bc_hot_tag () -> u64 {
+  use core::sync::atomic::{AtomicU8, Ordering};
+  unsafe extern "C" { fn getenv(name: *const c_char) -> *mut c_char; }
+  static TAG: AtomicU8 = AtomicU8::new(255);
+  let tag = TAG.load(Ordering::Relaxed);
+  if tag != 255 { return tag as u64; }
+  let tag = unsafe {
+    let p = getenv(c"FEMACS_BC_TAG".as_ptr());
+    if !p.is_null() && *p == b'0' as c_char {0} else {2}
+  };
+  TAG.store(tag, Ordering::Relaxed);
+  tag as u64
+}
